{
    "name": "survos/mobile-bundle",
    "description": "Bundle with utilities for creating a Symfony-based mobile app",
    "keywords": [
        "symfony-ux"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.4",
        "knplabs/knp-menu-bundle": "^3.2",
        "symfony/event-dispatcher": "^8.1",
        "symfony/ux-twig-component": "^3",
        "symfony/options-resolver": "^8.1",
        "survos/kit-bundle": "^2.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/security-bundle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\MobileBundle\\": "src/"
        }
    }
}