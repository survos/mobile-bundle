{
    "name": "survos/mobile-bundle",
    "description": "Declarative #[MobilePage] app pages + generic Framework7/Dexie app-shell wiring for Symfony mobile PWAs",
    "keywords": [
        "symfony-ux"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/routing": "^8.1",
        "twig/twig": "^3.4",
        "symfony/ux-twig-component": "^3",
        "symfony/ux-icons": "^2.29 || ^3.0",
        "survos/kit-bundle": "^2.5",
        "survos/atlas-bundle": "*",
        "survos/fw-bundle": "*",
        "survos/js-twig-bundle": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/security-bundle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\MobileBundle\\": "src/"
        }
    }
}
